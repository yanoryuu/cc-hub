{
  "name": "@cc-hub/daemon",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main.js --external:@lydell/node-pty --external:better-sqlite3 --external:@xterm/headless --external:@xterm/addon-serialize --external:ws --sourcemap",
    "start": "npm run build && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "build:test": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-test/main.js --external:@lydell/node-pty --external:better-sqlite3 --external:@xterm/headless --external:@xterm/addon-serialize --external:ws --sourcemap",
    "test": "esbuild test/approval.test.ts test/pr.test.ts test/tools.test.ts test/project.test.ts test/history.test.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist-test --external:better-sqlite3 && node dist-test/approval.test.js && node dist-test/pr.test.js && node dist-test/tools.test.js && node dist-test/project.test.js && node dist-test/history.test.js",
    "build:p3": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-p3/main.js --external:@lydell/node-pty --external:better-sqlite3 --external:@xterm/headless --external:@xterm/addon-serialize --external:ws --sourcemap",
    "build:p5": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-p5/main.js --external:@lydell/node-pty --external:better-sqlite3 --external:@xterm/headless --external:@xterm/addon-serialize --external:ws --sourcemap",
    "build:p4": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-p4/main.js --external:@lydell/node-pty --external:better-sqlite3 --external:@xterm/headless --external:@xterm/addon-serialize --external:ws --sourcemap",
    "build:p6": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-p6/main.js --external:@lydell/node-pty --external:better-sqlite3 --external:@xterm/headless --external:@xterm/addon-serialize --external:ws --sourcemap"
  },
  "dependencies": {
    "@cc-hub/shared": "0.1.0",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "basic-ftp": "^6.2.3",
    "better-sqlite3": "^11.10.0",
    "node-notifier": "^10.0.1",
    "ssh2-sftp-client": "^12.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "@types/node-notifier": "^8.0.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
